# Firebase Analytics — bkz. src/analitik.ts
#
# Bu degerler GIZLI DEGILDIR (Firebase web yapilandirmasi istemciye zaten
# gonderilir), ama depoda tutulmuyorlar ki:
#   - gelistirme ve test verisi gercek olculere karismasin
#   - depoyu klonlayan baskasinin projesine olcum gondermesin
#
# Kurulum:
#   1. console.firebase.google.com > yeni proje
#   2. Web uygulamasi ekle > yapilandirmayi buraya kopyala
#   3. Bu dosyayi `.env.local` olarak kaydet
#
# Degiskenler yoksa olcum SESSIZCE KAPALI kalir; uygulama normal calisir.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
